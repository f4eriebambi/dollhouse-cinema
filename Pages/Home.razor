@page "/"

@inject ITmdbService TmdbService
@inject IOmdbService OmdbService

@using DollhouseCinema.Services

<PageTitle>dollhouse cinema</PageTitle>

<section class="hero">
    <div class="hero-content">
        <div class="eyebrow">welcome to your dollhouse</div>
        <h1>your next favourite film is waiting </h1>
        <p>Discover films, save them for later, and keep a record of the ones that mean something to you.</p>
        <NavLink class="btn light" href="explore">
            explore films ↗
        </NavLink>
    </div>
</section>

<section class="section">
    <div class="section-head">
        <div>
            <div class="eyebrow">films to discover</div>
            <h2>Now Showing</h2>
        </div>
        <NavLink class="link-btn" href="explore">see all films ↗</NavLink>
    </div>

    <div class="poster-grid">
        @if (_films == null)
        {
            <div class="status-box" style="grid-column: 1 / -1;">
                <div class="status-icon">▌│𝄃𝄃𝄂𝄂𝄀𝄁𝄃█║║▌║</div>
                <h3>loading films ...</h3>
            </div>
        }
        else if (_films.Count == 0)
        {
            <div class="status-box" style="grid-column: 1 / -1;">
                <div class="status-icon">🔎︎</div>
                <h3>no films found</h3>
                <p>something went wrong ... oops</p>
            </div>
        }
        else
        {
            @foreach (var film in _films)
            {
                <article class="poster-card" 
                         @onclick="() => _selectedFilm = film" 
                         style="cursor: pointer;">
                    <img class="poster" src="@film.PosterUrl" alt="@film.Title poster" />
                    <div class="poster-caption">
                        <strong>@film.Title</strong>
                        <span>@film.Year · @film.Genre</span>
                    </div>
                </article>
            }
        }
    </div>
</section>

<section class="section">
    <div class="section-head">
        <div>
            <div class="eyebrow">your personal collections</div>
            <h2>From your dollhouse</h2>
            <p style="color: var(--muted)">Your handmade film collections, curated just for you by you</p>
        </div>
        <NavLink class="link-btn" href="dollhouse">all collections ↗</NavLink>
    </div>

    <div class="collection-grid">
        @for (int i = 0; i < SampleData.CuratedCollections.Count; i++)
        {
            var collection = SampleData.CuratedCollections[i];
            var colourClass = SampleData.CollectionColours[i % SampleData.CollectionColours.Count];
            <article class="collection-card @colourClass">
                <div class="eyebrow">0@(i + 1)</div>
                <h3>@collection.Title</h3>
                <p>@collection.Description</p>
            </article>
        }
    </div>
</section>

<FilmDetailsModal Film="_selectedFilm" OnClose="() => _selectedFilm = null" />

@code {
    private List<Film>? _films;
    private Film? _selectedFilm;

    protected override async Task OnInitializedAsync()
    {
        // get the films from tmdb
        _films = await TmdbService.GetFilmsByIdsAsync(SampleData.LobbyFilmIds);

        // loop through and get imdb rating from omdb
        if (_films != null)
        {
            foreach (var film in _films)
            {
                var rating = await OmdbService.GetImdbRatingAsync(film.Title, film.Year);
                film.ImdbRating = rating;
            }
        }
    }
}