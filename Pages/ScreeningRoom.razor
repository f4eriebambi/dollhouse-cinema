@page "/screening"

@inject WatchlistService WatchlistService

@using DollhouseCinema.Services

<PageTitle>screening room · dollhouse cinema</PageTitle>

<section class="section">
    <div class="section-head">
        <div>
            <div class="eyebrow">your film diary</div>
            <h2>the screening room</h2>
            <p style="color: var(--muted);">the films you've watched</p>
        </div>
    </div>

    @if (WatchedFilms.Count == 0)
    {
        <div class="status-box">
            <div class="status-icon">📽</div>
            <h3>No films watched yet</h3>
            <p>finished a film? add it here to rate it and keep your thoughts</p>
            <NavLink class="btn outline" href="explore">explore</NavLink>
        </div>
    }
    else
    {
        <div class="explore-grid">
            @foreach (var film in WatchedFilms)
            {
                <article class="poster-card" @onclick="() => _selectedFilm = film" style="cursor: pointer;">
                    <img class="poster" src="@film.PosterUrl" alt="@film.Title poster" />
                    <div class="poster-caption">
                        <strong>@film.Title</strong>
                        <span>@film.Year · @film.Genre</span>
                    </div>
                </article>
            }
        </div>
    }
</section>

<FilmDetailsModal Film="_selectedFilm" OnClose="() => _selectedFilm = null" />

@code {
    private Film? _selectedFilm;
    private List<Film> WatchedFilms => WatchlistService.GetWatched();
}