@page "/screening"

@inject WatchlistService WatchlistService

@using DollhouseCinema.Services

<PageTitle>screening room · dollhouse cinema</PageTitle>

<section class="section">
    <div class="section-head">
        <div>
            <div class="eyebrow">your film diary</div>
            <h2>the screening room</h2>
            <p style="color: var(--muted);">the films you've watched</p>
        </div>
    </div>

    <div class="stats-row" style="display: flex; gap: 20px; margin-bottom: 30px;">
        <div class="stat-box">
            <div class="stat-number">@WatchedFilms.Count</div>
            <div class="stat-label">films watched</div>
        </div>
        <div class="stat-box">
            <div class="stat-number">@RatedCount</div>
            <div class="stat-label">films rated</div>
        </div>
    </div>

    @if (WatchedFilms.Count == 0)
    {
        <div class="status-box">
            <div class="status-icon">📽</div>
            <h3>No films watched yet</h3>
            <p>finished a film? add it here to rate it and keep your thoughts</p>
            <NavLink class="btn outline" href="explore">explore</NavLink>
        </div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 20px;">
            @foreach (var film in WatchedFilms)
            {
                <div class="diary-row">
                    <img class="diary-poster" src="@film.PosterUrl" alt="@film.Title poster" />
                    
                    <div class="diary-info">
                        <h3>@film.Title</h3>
                        <div class="meta">@film.Year · @film.Genre</div>
                        <p>@film.Description</p>

                        @if (film.UserRating != null)
                        {
                            <div class="user-rating">your rating: <strong>@film.UserRating/10</strong></div>
                            }
                        
                        @if (film.WatchDate != null)
                        {
                            <div class="user-rating">watched on: <strong>@film.WatchDate.Value.ToString("dd MMM yyyy")</strong></div>
                        }
                        
                        @if (!string.IsNullOrEmpty(film.UserNotes))
                        {
                            <div class="user-notes">"@film.UserNotes"</div>
                        }
                    </div>
                    
                    <div class="diary-actions">
                        <button class="btn small" @onclick="() => EditDiary(film)">edit diary</button>
                        <button class="btn outline small" @onclick="() => AskToRemove(film)">remove</button>
                    </div>
                </div>
            }
        </div>
    }
</section>

<DiaryModal Film="_editingFilm" OnClose="() => _editingFilm = null" />

<ConfirmModal IsVisible="_showConfirm" 
              Message="@($"Remove {_filmToRemove?.Title} from your diary?")" 
              OnConfirm="ConfirmRemove" 
              OnCancel="() => _showConfirm = false" />

@code {
    private Film? _editingFilm;
    private bool _showConfirm = false;
    private Film? _filmToRemove;
    
    private List<Film> WatchedFilms => WatchlistService.GetWatched().ToList();
    private int RatedCount => WatchedFilms.Count(f => f.UserRating != null);

    private void EditDiary(Film film)
    {
        _editingFilm = film;
    }
    
    private void AskToRemove(Film film)
    {
        _filmToRemove = film;
        _showConfirm = true;
    }

    private void ConfirmRemove()
    {
        if (_filmToRemove != null)
        {
            WatchlistService.UnmarkWatched(_filmToRemove);
        }
        _showConfirm = false;
    }
}