@page "/watchlist"

@inject WatchlistService WatchlistService

@using DollhouseCinema.Services

<PageTitle>watchlist · dollhouse cinema</PageTitle>

<section class="section">
    <div class="section-head">
        <div>
            <div class="eyebrow">awaiting its premiere</div>
            <h2>your watchlist</h2>
            <p style="color: var(--muted);">a little list of films calling yuor name</p>
        </div>
    </div>

    @if (SavedFilms.Count == 0)
    {
        <div class="status-box">
            <div class="status-icon">🎞</div>
            <h3>No screenings scheduled</h3>
            <p>save some films for your next movie night</p>
            <NavLink class="btn outline" href="explore">find a film ↗</NavLink>
        </div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 20px;">
            @foreach (var film in SavedFilms)
            {
                <div class="diary-row">
                    <img class="diary-poster" src="@film.PosterUrl" alt="@film.Title poster" />
                    
                    <div class="diary-info">
                        <h3>@film.Title</h3>
                        <div class="meta">@film.Year · @film.Genre</div>
                        <p>@film.Description</p>
                        
                        @if (!string.IsNullOrEmpty(film.ImdbRating))
                        {
                            <div class="imdb-rating">imdb rating: @film.ImdbRating/10</div>
                        }
                    </div>
                    
                    <div class="diary-actions">
                        <button class="btn small" @onclick="() => MarkWatched(film)">mark watched</button>
                    </div>
                </div>
            }
        </div>
    }
</section>

@code {
    private List<Film> SavedFilms => WatchlistService.GetAll();

    private void MarkWatched(Film film)
    {
        WatchlistService.MarkWatched(film);
    }
}