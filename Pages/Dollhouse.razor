@page "/dollhouse"

@inject ITmdbService TmdbService
@inject WatchlistService WatchlistService

@using DollhouseCinema.Services

<PageTitle>the dollhouse · dollhouse cinema</PageTitle>

<section class="section">
    <div class="section-head">
        <div>
            <div class="eyebrow">every story has its place</div>
            <h2>the dollhouse</h2>
            <p style="color: var(--muted);">to all the films you've ever loved</p>
        </div>
    </div>

    @* collection and keepsakes tabs *@
    <div class="tabs" style="display: flex; gap: 20px; border-bottom: 1px solid var(--line); margin-bottom: 24px;">
        <button class="tab-btn @(_activeTab == "collections" ? "active" : "")" @onclick='() => SwitchTab("collections")'>my collections</button>
        <button class="tab-btn @(_activeTab == "keepsakes" ? "active" : "")" @onclick='() => SwitchTab("keepsakes")'>keepsakes ♡</button>
    </div>

    @* collections tab *@
    @if (_activeTab == "collections")
    {
        @if (_selectedCollection == null)
        {
            <div class="collection-grid">
                @for (int i = 0; i < SampleData.CuratedCollections.Count; i++)
                {
                    var collection = SampleData.CuratedCollections[i];
                    var collectionImage = GetCollectionImage(collection.Title);
                    var filmCount = SampleData.CollectionFilmIds.TryGetValue(collection.Title, out var filmIds)
                        ? filmIds.Count
                        : 0;

                    <article class="collection-card"
                             style="cursor: pointer;"
                             @onclick="() => OpenCollection(collection.Title)">
                        <div class="collection-image">
                            <img src="@collectionImage" alt="" />
                        </div>
                        <div class="collection-content">
                            <div class="eyebrow">0@(i + 1)</div>
                            <h3>@collection.Title</h3>
                            <p>@collection.Description</p>
                            <p class="collection-count">@filmCount films</p>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div style="margin-bottom: 20px;">
                <button class="btn outline small" @onclick="CloseCollection">← back</button>
            </div>
            
            <h2 style="margin-bottom: 4px;">@_selectedCollection</h2>
            
            <p style="color: var(--muted); margin-bottom: 20px;">
                @SampleData.CuratedCollections.FirstOrDefault(c => c.Title == _selectedCollection)?.Description
            </p>
            
            @if (_isLoading)
            {
                <div class="status-box">
                    <div class="status-icon">▌│𝄃𝄃𝄂𝄂𝄀𝄁𝄃█║║▌║</div>
                    <h3>loading films...</h3>
                </div>
            }
            else
            {
                <div class="explore-grid">
                    @foreach (var film in _collectionFilms)
                    {
                        <article class="poster-card" @onclick="() => _selectedFilm = film" style="cursor: pointer;">
                            <img class="poster" src="@film.PosterUrl" alt="@film.Title poster" />
                            <div class="poster-caption">
                                <strong>@film.Title</strong>
                                <span>@film.Year · @film.Genre</span>
                            </div>
                        </article>
                    }
                </div>
            }
        }
    }
    
    @* favorites tab *@
    else if (_activeTab == "keepsakes")
    {
        @if (_favFilms.Count == 0)
        {
            <div class="status-box">
                <div class="status-icon">🗝</div>
                <h3>Your keepsakes are empty</h3>
                <p>tap the heart on a film to keep it here.</p>
            </div>
        }
        else
        {
            <div class="explore-grid">
                @foreach (var film in _favFilms)
                {
                    <article class="poster-card" @onclick="() => _selectedFilm = film" style="cursor: pointer;">
                        <img class="poster" src="@film.PosterUrl" alt="@film.Title poster" />
                        <div class="poster-caption">
                            <strong>@film.Title</strong>
                            <span>@film.Year · @film.Genre</span>
                        </div>
                    </article>
                }
            </div>
        }
    }
</section>

<FilmDetailsModal Film="_selectedFilm" OnClose="() => _selectedFilm = null" />

@code {
    private string _activeTab = "collections";
    private string? _selectedCollection;
    private List<Film> _collectionFilms = new();
    private bool _isLoading = false;
    private Film? _selectedFilm;

    private List<Film> _favFilms = new();

    [SupplyParameterFromQuery(Name = "collection")]
    public string? CollectionFromQuery { get; set; }

    private string? _lastOpenedCollection;

    private string GetCollectionImage(string collectionTitle)
    {
        return collectionTitle switch
        {
            "comfort <333" => "/images/collections/comfort.jpg",
            "gothic." => "/images/collections/gothic.jpg",
            "im just a monster in love" => "/images/collections/monsterinlove.jpg",
            "weird girl movies" => "/images/collections/weirdgirlmovies.jpg",
            _ => "/images/placeholder.jpg"
        };
    }

    protected override void OnInitialized()
    {
        LoadFavorites();
    }
    
    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(CollectionFromQuery))
        {
            _lastOpenedCollection = null;
            return;
        }

        if (_lastOpenedCollection == CollectionFromQuery)
        {
            return;
        }
        
        if (!SampleData.CollectionFilmIds.ContainsKey(CollectionFromQuery))
        {
            return;
        }

        _lastOpenedCollection = CollectionFromQuery;
        _activeTab = "collections";

        await OpenCollection(CollectionFromQuery);
    }

    private void SwitchTab(string tab)
    {
        _activeTab = tab;
        _selectedCollection = null;
        
        if (tab == "keepsakes")
        {
            LoadFavorites();
        }
    }

    private void LoadFavorites()
    {
        _favFilms = WatchlistService.GetFavorites();
    }

    private async Task OpenCollection(string collectionName)
    {
        _selectedCollection = collectionName;
        _isLoading = true;
        _collectionFilms = new();

        if (SampleData.CollectionFilmIds.TryGetValue(collectionName, out var ids))
        {
            _collectionFilms = await TmdbService.GetFilmsByIdsAsync(ids);
        }

        _isLoading = false;
    }

    private void CloseCollection()
    {
        _selectedCollection = null;
        _collectionFilms = new();
    }
}