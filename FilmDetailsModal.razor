@inject WatchlistService Watchlist

@using DollhouseCinema.Services

@if (Film != null)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-box" @onclick:stopPropagation="true">
            <button class="modal-close" @onclick="Close">✕</button>
            
            <div class="modal-header">
                <div class="eyebrow">film details</div>
                <h2>@Film.Title</h2>
                <span style="color: var(--muted); font-size: 13px;">@Film.Year · @Film.Genre</span>
            </div>

            <div class="modal-film-info">
                <img src="@Film.PosterUrl" alt="@Film.Title poster" class="modal-poster" />
                
                <div class="modal-details">
                    <p>@Film.Description</p>
                    
                    @if (!string.IsNullOrEmpty(Film.ImdbRating))
                    {
                        <div class="imdb-rating">imdb @Film.ImdbRating/10</div>
                    }
                </div>
            </div>
            
            <div style="margin-top: 10px; display: flex; gap: 10px;">
                
                @* watchlist button *@
                @if (Watchlist.IsSaved(Film))
                {
                    <button class="btn outline small" @onclick="RemoveFromWatchlist">remove from watchlist</button>
                }
                else
                {
                    <button class="btn small" @onclick="AddToWatchlist">+ add to watchlist</button>
                }
                
                @* watched/screenig room button *@
                @if (Watchlist.IsWatched(Film))
                {
                    <button class="btn outline small" @onclick="UnmarkWatched">remove from watched</button>
                }
                else
                {
                    <button class="btn small" @onclick="MarkWatched">✓ mark as watched</button>
                }
                
                @* fav film button *@
                @if (Watchlist.IsFavorite(Film))
                {
                    <button class="btn small" @onclick="ToggleFavorite">❤︎</button>
                }
                else
                {
                    <button class="btn outline small" @onclick="ToggleFavorite">ᰔᩚ</button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Film? Film { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
    
    private void AddToWatchlist()
    {
        if (Film != null)
        {
            Watchlist.Add(Film);
            StateHasChanged(); // tells ui to refresh
        }
    }

    private void RemoveFromWatchlist()
    {
        if (Film != null)
        {
            Watchlist.Remove(Film);
            StateHasChanged(); // tells ui to refresh
        }
    }
    
    private void MarkWatched()
    {
        if (Film != null)
        {
            Watchlist.MarkWatched(Film);
            StateHasChanged();
        }
    }

    private void UnmarkWatched()
    {
        if (Film != null)
        {
            Watchlist.UnmarkWatched(Film);
            StateHasChanged();
        }
    }
    
    private void ToggleFavorite()
    {
        if (Film != null)
        {
            if (Watchlist.IsFavorite(Film))
                Watchlist.RemoveFavorite(Film);
            else
                Watchlist.AddFavorite(Film);
                
            StateHasChanged();
        }
    }
}